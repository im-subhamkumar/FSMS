// This is your Prisma schema file — the single source of truth for the database.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Base User model — all team modules should relate to this model
// ──────────────────────────────────────────────────────────────
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  firstName String   @db.VarChar(100)
  lastName  String   @db.VarChar(100)
  role      Role     @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations for Flying Slots
  sessionsAsStudent     FlyingSlot[]  @relation("StudentSessions")
  sessionsAsInstructor  FlyingSlot[]  @relation("InstructorSessions")
  requestsAsStudent     SlotRequest[] @relation("StudentRequests")

  @@map("users")
}

// Role enum — extend as needed by individual teams
enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
  STAFF
}

// ──────────────────────────────────────────────────────────────
// Flying Slots / Sessions Models
// ──────────────────────────────────────────────────────────────

model FlyingSlot {
  id           Int        @id @default(autoincrement())
  date         DateTime   @db.Date
  startTime    String     @db.VarChar(5) // e.g. '08:00'
  endTime      String     @db.VarChar(5) // e.g. '10:00'
  status       SlotStatus @default(SCHEDULED)
  aircraft     String     @db.VarChar(50)
  notes        String?    @db.Text

  studentId    Int
  instructorId Int

  student      User       @relation("StudentSessions", fields: [studentId], references: [id])
  instructor   User       @relation("InstructorSessions", fields: [instructorId], references: [id])

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("flying_slots")
}

model SlotRequest {
  id                   Int           @id @default(autoincrement())
  date                 DateTime      @db.Date
  timePreference       String        @db.VarChar(100)
  instructorPreference String        @db.VarChar(100)
  aircraftPreference   String        @db.VarChar(50)
  notes                String?       @db.Text
  status               RequestStatus @default(PENDING)

  studentId            Int
  student              User          @relation("StudentRequests", fields: [studentId], references: [id])

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("slot_requests")
}

enum SlotStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}
