# ============================================================
# FSMS Backend — Environment Variables
# Docker MySQL container connection string
# ============================================================

# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# HOST must be the docker-compose service name: "db"
DATABASE_URL="mysql://fsms_user:fsms_password@db:3306/fsms_db"

# Express server port (docker-compose maps this to host port 3000)
PORT=3000

# Node environment
NODE_ENV=development
